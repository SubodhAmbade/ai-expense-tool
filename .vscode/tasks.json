{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: test",
      "type": "shell",
      "command": ".venv/Scripts/python -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "group": "test"
    },
    {
      "label": "api: lint",
      "type": "shell",
      "command": ".venv/Scripts/python -m ruff check . && .venv/Scripts/python -m ruff format --check .",
      "options": { "cwd": "${workspaceFolder}/apps/api" }
    },
    {
      "label": "web: lint",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/apps/web" }
    }
  ]
}
